// Top bar + floating frosted-glass bottom dock for Hyprland / Waybar
[
    {
        "name": "top-bar",
        "layer": "top",
        "position": "top",
        "height": 38,
        "margin-top": 6,
        "margin-left": 12,
        "margin-right": 12,
        "spacing": 6,
        "modules-left": [
            "custom/brand",
            "hyprland/workspaces",
            "hyprland/window"
        ],
        "modules-center": [
            "clock",
            "custom/media"
        ],
        "modules-right": [
            "custom/clipboard",
            "custom/snip",
            "custom/keys",
            "cpu",
            "memory",
            "disk",
            "wireplumber",
            "network",
            "tray",
            "custom/power"
        ],
        "custom/brand": {
            "format": "󰣇",
            "tooltip-format": "Orbit Launch",
            "on-click": "/home/jacob/.local/bin/orbit-launch"
        },
        "hyprland/workspaces": {
            "disable-scroll": true,
            "all-outputs": true,
            "format": "{name}",
            "on-click": "activate"
        },
        "hyprland/window": {
            "max-length": 42,
            "separate-outputs": true
        },
        "clock": {
            "format": "󰥔  {:%a, %b %d • %I:%M %p}",
            "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
            "on-click": "notify-send 'Calendar' \"$(cal)\""
        },
        "custom/media": {
            "format": "󰎆",
            "tooltip": false,
            "on-click": "pavucontrol"
        },
        "custom/clipboard": {
            "format": "󰅍",
            "tooltip-format": "Clipboard History",
            "on-click": "/home/jacob/.local/bin/hypr-clipboard"
        },
        "custom/snip": {
            "format": "󰄀",
            "tooltip-format": "Screenshot Tool",
            "on-click": "/home/jacob/.local/bin/hypr-screenshot",
            "on-click-right": "/home/jacob/.local/bin/hypr-screenshot config"
        },
        "custom/keys": {
            "format": "󰌌",
            "tooltip-format": "Show Shortcuts",
            "on-click": "notify-send 'Keybinds' 'Super+Return: Orbit Term\nSuper+D: Orbit Launch\nSuper+E: Orbit Files\nSuper+N: LazyVim\nSuper+B: Browser\nSuper+C: Close Window\nSuper+Shift+Q: Exit'"
        },
        "cpu": {
            "interval": 2,
            "format": "󰻠 {usage}%",
            "tooltip": false,
            "on-click": "kitty -e btop"
        },
        "memory": {
            "interval": 2,
            "format": "󰍛 {used:0.1f}G ({percentage}%)",
            "tooltip": false,
            "on-click": "kitty -e btop"
        },
        "disk": {
            "interval": 30,
            "format": "󰋊 {free} ({percentage_used}%)",
            "path": "/",
            "on-click": "kitty -e btop"
        },
        "wireplumber": {
            "format": "{icon} {volume}%",
            "format-muted": "󰝟 Muted",
            "format-icons": ["", "", ""],
            "on-click": "pavucontrol"
        },
        "network": {
            "format-ethernet": "󰈀",
            "format-wifi": "󰖩",
            "format-disconnected": "󰈂",
            "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
            "on-click": "nm-connection-editor"
        },
        "tray": {
            "icon-size": 16,
            "spacing": 6
        },
        "custom/power": {
            "format": " ⏻ ",
            "tooltip": false,
            "on-click": "hyprctl dispatch exit"
        }
    },
    {
        "name": "bottom-dock",
        "layer": "top",
        "position": "bottom",
        "height": 46,
        "margin-bottom": 8,
        "margin-left": 180,
        "margin-right": 180,
        "spacing": 4,
        "modules-left": [
            "custom/start",
            "custom/search"
        ],
        "modules-center": [
            "custom/term",
            "custom/files",
            "custom/web",
            "wlr/taskbar"
        ],
        "modules-right": [
            "custom/showdesktop"
        ],
        "custom/start": {
            "format": "󰀻 Apps",
            "tooltip-format": "Orbit Launch (Super+D)",
            "on-click": "/home/jacob/.local/bin/orbit-launch"
        },
        "custom/search": {
            "format": " Search…",
            "tooltip-format": "Search apps, = math, > run",
            "on-click": "/home/jacob/.local/bin/orbit-launch"
        },
        "custom/term": {
            "format": "󰞷",
            "tooltip-format": "Orbit Term (Super+Return)",
            "on-click": "/home/jacob/.local/bin/orbit-term"
        },
        "custom/files": {
            "format": "󰉋",
            "tooltip-format": "Orbit Files (Super+E)",
            "on-click": "/home/jacob/.local/bin/orbit-files"
        },
        "custom/web": {
            "format": "󰈹",
            "tooltip-format": "Brave Browser (Super+B)",
            "on-click": "brave"
        },
        "wlr/taskbar": {
            "format": "{icon}",
            "icon-size": 20,
            "tooltip-format": "{title}",
            "on-click": "activate",
            "on-click-middle": "close"
        },
        "custom/showdesktop": {
            "format": " ",
            "tooltip-format": "Switch to Empty Workspace",
            "on-click": "hyprctl dispatch workspace empty"
        }
    }
]
